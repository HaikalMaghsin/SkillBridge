# Salin menjadi .env untuk lokal (JANGAN di-commit), atau isi sebagai Environment Variables di hosting.

# Produksi: 0. Isi 1 hanya untuk menguji UI tanpa database (membuka sesi demo).
APP_DEMO=0

# --- PostgreSQL lokal ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=skillbridge
DB_USER=postgres
DB_PASS=
DB_SSLMODE=prefer

# --- Supabase (ambil nilai persisnya di dashboard: Connect -> Session pooler) ---
# DB_HOST=aws-0-<region>.pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres.<project-ref>
# DB_PASS=<password database>
# DB_SSLMODE=require
# Jika memakai Transaction pooler (port 6543), aktifkan ini:
# DB_EMULATE_PREPARES=1

# --- Cloudflare R2 Storage (Bucket: skillbridge) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=skillbridge
R2_PUBLIC_URL=

# --- SMTP Mailer (Lupa Password & Verifikasi Email) ---
# Kosongkan untuk mode log lokal (data/mail_logs.json).
# Atau isi jika ingin kirim email sungguhan (misal Gmail App Password / Mailtrap / Brevo):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls
SMTP_FROM=noreply@skillsbridge.my.id
SMTP_FROM_NAME=SkillBridge Support


